# Gemini API Key Configuration
# Get your key from: https://aistudio.google.com/app/apikey

# For local development: Rename this file to .env and fill in your key
# For production (Vercel/Netlify): Add this variable in the project settings dashboard

GEMINI_API_KEY=your_api_key_here

# Alipay Configuration
# Get these from https://open.alipay.com
 ALIPAY_APP_ID=your_app_id
 ALIPAY_PRIVATE_KEY=your_private_key
 ALIPAY_PUBLIC_KEY=your_public_key
 # Optional: Set if using Sandbox (https://openapi-sandbox.dl.alipaydev.com/gateway.do)
 # ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
