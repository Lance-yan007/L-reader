{
    "buildCommand": "echo 'No build needed for static site'",
    "outputDirectory": ".",
    "routes": [
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "src": "/app.html",
            "dest": "/app.html"
        },
        {
            "src": "/src/(.*)",
            "dest": "/src/$1"
        },
        {
            "src": "/web-utils/(.*)",
            "dest": "/web-utils/$1"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        }
    ]
}